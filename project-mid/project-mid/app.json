{
  "expo": {
    "name": "Quản lý sản phẩm",
    "slug": "project-mid",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh sản phẩm từ thư viện.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
