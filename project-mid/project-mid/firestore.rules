rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '0Um0Tb3Bw9bCFoHxLdOT0feuVlK2'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function validProduct() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'price', 'soluong', 'hinhanh'])
        && data.keys().hasOnly(['name', 'price', 'soluong', 'hinhanh'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (data.price is number || data.price is int) && data.price >= 0
        && (data.soluong is number || data.soluong is int) && data.soluong >= 0
        && data.hinhanh is string && data.hinhanh.size() <= 220000
        && data.hinhanh.matches('^data:image/(jpeg|png|jpg);base64,[A-Za-z0-9+/]+=*$');
    }

    match /sanpham/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }
  }
}
